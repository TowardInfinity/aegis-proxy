{
  "env": {
    "ANTHROPIC_BASE_URL": "https://aegis.corp.example",
    "ANTHROPIC_API_KEY": "",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "apiKeyHelper": "/usr/local/bin/aegis-employee-token",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Read(./secrets/**)"
    ]
  }
}
